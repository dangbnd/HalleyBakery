{
  "devCommand": "node scripts/vercel-dev.cjs",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "geolocation=(), camera=(), microphone=()" },
        { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/all",
      "destination": "/api/all"
    },
    {
      "source": "/api/og",
      "destination": "/api/og"
    },
    {
      "source": "/:path((?!api/|@vite/|@react-refresh|__vite_ping|node_modules/)(?!.*\\.[^/]+$).*)",
      "destination": "/api/og"
    }
  ],
  "functions": {
    "api/all.js": {
      "memory": 256
    },
    "api/og.js": {
      "memory": 256,
      "includeFiles": "dist/_app.html"
    }
  }
}
